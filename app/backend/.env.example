# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Provide one or both — either is sufficient for AI responses
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Biomedical APIs (all free, keys improve rate limits) ──────────────────────
PUBMED_API_KEY=your_pubmed_api_key_here
NCBI_API_KEY=your_ncbi_api_key_here
# CHEMBL_API_KEY is not required — ChEMBL REST API is public

# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_secret
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
PORT=5001

# ── Database ───────────────────────────────────────────────────────────────────
# Defaults to SQLite. For Postgres: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///drug_discovery.db

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
