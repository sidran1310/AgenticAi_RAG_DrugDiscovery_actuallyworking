import React, { useState, useRef, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { ScrollArea } from "@/components/ui/scroll-area";
import { Card } from "@/components/ui/card";
import { Alert, AlertDescription } from "@/components/ui/alert";
import {
  Brain,
  Wrench,
  Eye,
  CheckCircle2,
  Send,
  Loader2,
  Sparkles,
  Bot,
  User,
  ChevronDown,
  ChevronRight,
  AlertCircle,
  MessageSquare,
} from "lucide-react";
import { sendChatMessage, getAvailableAgents, AgentInfo, ChatResponse } from "@/lib/api";

interface ReActStep {
  type: "thought" | "action" | "observation" | "answer";
  content: string;
  tool?: string;
  args?: Record<string, string>;
  timestamp: string;
}

interface ChatMessage {
  id: string;
  role: "user" | "agent";
  content: string;
  steps?: ReActStep[];
  timestamp: string;
  error?: string;
  metadata?: any;
}

const AgentChat: React.FC = () => {
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [inputValue, setInputValue] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [expandedSteps, setExpandedSteps] = useState<Set<string>>(new Set());
  const scrollAreaRef = useRef<HTMLDivElement>(null);

  // Load chat history from localStorage
  useEffect(() => {
    const savedMessages = localStorage.getItem('drug-discovery-chat');
    if (savedMessages) {
      try {
        setMessages(JSON.parse(savedMessages));
      } catch (e) {
        console.error('Failed to load chat history:', e);
      }
    }
  }, []);

  // Save chat history to localStorage
  useEffect(() => {
    if (messages.length > 0) {
      localStorage.setItem('drug-discovery-chat', JSON.stringify(messages));
    }
  }, [messages]);

  // Auto-scroll to bottom
  useEffect(() => {
    if (scrollAreaRef.current) {
      scrollAreaRef.current.scrollTop = scrollAreaRef.current.scrollHeight;
    }
  }, [messages]);

  const handleSendMessage = async () => {
    if (!inputValue.trim() || isLoading) return;

    const userMessage: ChatMessage = {
      id: Date.now().toString(),
      role: "user",
      content: inputValue.trim(),
      timestamp: new Date().toLocaleTimeString(),
    };

    setMessages(prev => [...prev, userMessage]);
    setInputValue("");
    setIsLoading(true);
    setError(null);

    try {
      const response: ChatResponse = await sendChatMessage(userMessage.content);

      const agentMessage: ChatMessage = {
        id: (Date.now() + 1).toString(),
        role: "agent",
        content: response.response,
        timestamp: new Date().toLocaleTimeString(),
        metadata: response.metadata,
        steps: [
          ...response.thought_process.map(step => ({
            type: "thought" as const,
            content: step.content,
            timestamp: step.timestamp || new Date().toISOString(),
          })),
          ...response.actions.map(action => ({
            type: "action" as const,
            content: action.result,
            tool: action.tool,
            timestamp: new Date().toISOString(),
          })),
          ...response.observations.map(obs => ({
            type: "observation" as const,
            content: typeof obs === 'string' ? obs : obs.content,
            timestamp: new Date().toISOString(),
          })),
        ],
      };

      setMessages(prev => [...prev, agentMessage]);
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'An unexpected error occurred';
      setError(errorMessage);

      const errorMsg: ChatMessage = {
        id: (Date.now() + 1).toString(),
        role: "agent",
        content: "I apologize, but I encountered an error while processing your request.",
        timestamp: new Date().toLocaleTimeString(),
        error: errorMessage,
      };

      setMessages(prev => [...prev, errorMsg]);
    } finally {
      setIsLoading(false);
    }
  };

  const toggleStepExpansion = (messageId: string) => {
    setExpandedSteps(prev => {
      const newSet = new Set(prev);
      if (newSet.has(messageId)) {
        newSet.delete(messageId);
      } else {
        newSet.add(messageId);
      }
      return newSet;
    });
  };

  const clearChat = () => {
    setMessages([]);
    localStorage.removeItem('drug-discovery-chat');
  };

  const getStepIcon = (type: string) => {
    switch (type) {
      case "thought":
        return <Brain className="h-4 w-4 text-blue-500" />;
      case "action":
        return <Wrench className="h-4 w-4 text-orange-500" />;
      case "observation":
        return <Eye className="h-4 w-4 text-green-500" />;
      case "answer":
        return <CheckCircle2 className="h-4 w-4 text-purple-500" />;
      default:
        return <Sparkles className="h-4 w-4 text-gray-500" />;
    }
  };

  return (
    <Card className="flex flex-col h-full">
      {/* Header */}
      <div className="flex items-center justify-between p-4 border-b">
        <div className="flex items-center space-x-2">
          <Bot className="h-5 w-5 text-blue-600" />
          <h2 className="text-lg font-semibold">Drug Discovery AI Agent</h2>
        </div>
        <div className="flex items-center space-x-2">
          <Badge variant="secondary" className="text-xs">
            ReAct Agent
          </Badge>
          <Button
            variant="outline"
            size="sm"
            onClick={clearChat}
            disabled={messages.length === 0}
          >
            Clear Chat
          </Button>
        </div>
      </div>

      {/* Messages */}
      <ScrollArea className="flex-1 p-4" ref={scrollAreaRef}>
        <div className="space-y-4">
          {messages.length === 0 && (
            <div className="text-center text-gray-500 py-8">
              <MessageSquare className="h-12 w-12 mx-auto mb-4 opacity-50" />
              <p className="text-lg mb-2">Welcome to the Drug Discovery AI Agent!</p>
              <p className="text-sm">Ask me about drug candidates, molecular targets, or research questions.</p>
            </div>
          )}

          {messages.map((message) => (
            <div key={message.id} className="space-y-2">
              <div className={`flex ${message.role === "user" ? "justify-end" : "justify-start"}`}>
                <div
                  className={`max-w-[80%] rounded-lg p-3 ${
                    message.role === "user"
                      ? "bg-blue-600 text-white"
                      : message.error
                      ? "bg-red-50 border border-red-200"
                      : "bg-gray-100"
                  }`}
                >
                  <div className="flex items-center space-x-2 mb-1">
                    {message.role === "user" ? (
                      <User className="h-4 w-4" />
                    ) : (
                      <Bot className="h-4 w-4" />
                    )}
                    <span className="text-xs opacity-70">{message.timestamp}</span>
                  </div>
                  <p className="text-sm whitespace-pre-wrap">{message.content}</p>

                  {message.error && (
                    <Alert className="mt-2">
                      <AlertCircle className="h-4 w-4" />
                      <AlertDescription className="text-xs">
                        {message.error}
                      </AlertDescription>
                    </Alert>
                  )}

                  {message.metadata && (
                    <div className="mt-2 flex flex-wrap gap-1">
                      {message.metadata.topic && (
                        <Badge variant="outline" className="text-xs">
                          Topic: {message.metadata.topic}
                        </Badge>
                      )}
                      {message.metadata.pubmed_count > 0 && (
                        <Badge variant="outline" className="text-xs">
                          PubMed: {message.metadata.pubmed_count}
                        </Badge>
                      )}
                      {message.metadata.pdb_count > 0 && (
                        <Badge variant="outline" className="text-xs">
                          PDB: {message.metadata.pdb_count}
                        </Badge>
                      )}
                    </div>
                  )}
                </div>
              </div>

              {/* ReAct Steps */}
              {message.steps && message.steps.length > 0 && (
                <div className="ml-8 space-y-1">
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => toggleStepExpansion(message.id)}
                    className="text-xs"
                  >
                    {expandedSteps.has(message.id) ? (
                      <ChevronDown className="h-3 w-3 mr-1" />
                    ) : (
                      <ChevronRight className="h-3 w-3 mr-1" />
                    )}
                    Reasoning Steps ({message.steps.length})
                  </Button>

                  {expandedSteps.has(message.id) && (
                    <div className="space-y-2 pl-4 border-l-2 border-gray-200">
                      {message.steps.map((step, index) => (
                        <div key={index} className="flex items-start space-x-2">
                          {getStepIcon(step.type)}
                          <div className="flex-1">
                            <div className="flex items-center space-x-2 mb-1">
                              <Badge variant="secondary" className="text-xs capitalize">
                                {step.type}
                              </Badge>
                              {step.tool && (
                                <Badge variant="outline" className="text-xs">
                                  {step.tool}
                                </Badge>
                              )}
                            </div>
                            <p className="text-xs text-gray-600 whitespace-pre-wrap">
                              {step.content}
                            </p>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          ))}

          {isLoading && (
            <div className="flex justify-start">
              <div className="bg-gray-100 rounded-lg p-3 max-w-[80%]">
                <div className="flex items-center space-x-2 mb-2">
                  <Bot className="h-4 w-4" />
                  <span className="text-xs opacity-70">Thinking...</span>
                </div>
                <div className="flex items-center space-x-2">
                  <Loader2 className="h-4 w-4 animate-spin" />
                  <span className="text-sm text-gray-600">Processing your request</span>
                </div>
              </div>
            </div>
          )}
        </div>
      </ScrollArea>

      {/* Error Display */}
      {error && (
        <Alert className="m-4 mb-0">
          <AlertCircle className="h-4 w-4" />
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}

      {/* Input */}
      <div className="p-4 border-t">
        <div className="flex space-x-2">
          <Input
            value={inputValue}
            onChange={(e) => setInputValue(e.target.value)}
            placeholder="Ask about drug discovery, molecular targets, or research questions..."
            onKeyPress={(e) => e.key === "Enter" && handleSendMessage()}
            disabled={isLoading}
            className="flex-1"
          />
          <Button
            onClick={handleSendMessage}
            disabled={!inputValue.trim() || isLoading}
            size="icon"
          >
            {isLoading ? (
              <Loader2 className="h-4 w-4 animate-spin" />
            ) : (
              <Send className="h-4 w-4" />
            )}
          </Button>
        </div>
      </div>
    </Card>
  );
};

export default AgentChat;
    role: "agent",
    content: "",
    timestamp: "10:23 AM",
    steps: [
      {
        type: "thought",
        content:
          "The user wants to find drug candidates targeting beta-amyloid plaques in Alzheimer's disease. I should first search ChEMBL for compounds with known activity against amyloid-beta targets, then cross-reference with recent PubMed literature for clinical relevance.",
        timestamp: "10:23 AM",
      },
      {
        type: "action",
        content: "Searching ChEMBL for beta-amyloid targeting compounds",
        tool: "ChEMBL API",
        args: {
          target: "CHEMBL4296",
          activity_type: "IC50",
          limit: "25",
          organism: "Homo sapiens",
        },
        timestamp: "10:23 AM",
      },
      {
        type: "observation",
        content:
          "Found 847 compounds with reported IC50 values against beta-amyloid (1-42). Top candidates include: Aducanumab (CHEMBL4297891, IC50: 0.5nM), Lecanemab (CHEMBL4523167, IC50: 0.8nM), Donanemab (CHEMBL4651234, IC50: 1.2nM). Also found 12 novel small molecules in Phase I/II trials.",
        timestamp: "10:24 AM",
      },
      {
        type: "action",
        content: "Querying PubMed for recent clinical trial results",
        tool: "PubMed API",
        args: {
          query: "beta-amyloid drug candidate Alzheimer clinical trial 2024-2026",
          max_results: "15",
          sort: "relevance",
        },
        timestamp: "10:24 AM",
      },
      {
        type: "observation",
