        timestamp: "10:25 AM",
      },
      {
        type: "action",
        content: "Running molecular docking simulation for top candidates",
        tool: "Docking Engine",
        args: {
          protein_pdb: "6SZF",
          ligands: "aducanumab,lecanemab,donanemab",
          scoring: "Vina",
        },
        timestamp: "10:25 AM",
      },
      {
        type: "observation",
        content:
          "Docking scores: Aducanumab: -9.2 kcal/mol (strong binding), Lecanemab: -8.7 kcal/mol (strong), Donanemab: -8.1 kcal/mol (moderate-strong). All show favorable binding to the amyloid fibril interface.",
        timestamp: "10:26 AM",
      },
      {
        type: "answer",
        content:
          "Based on my comprehensive analysis across ChEMBL, PubMed, and molecular docking simulations, here are the top drug candidates for Alzheimer's targeting beta-amyloid:\n\n**Top 3 Candidates:**\n1. **Lecanemab** — IC50: 0.8nM, Docking: -8.7 kcal/mol. FDA-approved monoclonal antibody. Phase III CLARITY AD trial showed 27% slowing of cognitive decline.\n2. **Donanemab** — IC50: 1.2nM, Docking: -8.1 kcal/mol. Targets N-terminal pyroglutamate Aβ. TRAILBLAZER-ALZ 2 showed 35% slowing in early patients.\n3. **Aducanumab** — IC50: 0.5nM, Docking: -9.2 kcal/mol. Highest binding affinity but controversial efficacy data.\n\n**Emerging Candidates:**\n- 3 novel BACE inhibitors entering Phase II with improved safety profiles\n- 2 anti-aggregation small molecules showing promise in preclinical models\n\n**Recommendation:** Lecanemab currently shows the best efficacy-safety balance. Consider exploring the novel BACE inhibitors for next-generation therapeutic development.",
        timestamp: "10:26 AM",
      },
    ],
  },
];

const stepConfig = {
  thought: {
    icon: Brain,
    color: "text-violet-400",
    bg: "bg-violet-500/10",
    border: "border-violet-500/30",
    label: "Thought",
    badgeClass: "bg-violet-500/20 text-violet-300 border-violet-500/30",
  },
  action: {
    icon: Wrench,
    color: "text-cyan-400",
    bg: "bg-cyan-500/10",
    border: "border-cyan-500/30",
    label: "Action",
    badgeClass: "bg-cyan-500/20 text-cyan-300 border-cyan-500/30",
  },
  observation: {
    icon: Eye,
    color: "text-amber-400",
    bg: "bg-amber-500/10",
    border: "border-amber-500/30",
    label: "Observation",
    badgeClass: "bg-amber-500/20 text-amber-300 border-amber-500/30",
  },
  answer: {
    icon: CheckCircle2,
    color: "text-emerald-400",
    bg: "bg-emerald-500/10",
    border: "border-emerald-500/30",
    label: "Answer",
    badgeClass: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30",
  },
};

function ReActStepCard({ step }: { step: ReActStep }) {
  const [expanded, setExpanded] = useState(step.type === "answer");
  const config = stepConfig[step.type];
  const Icon = config.icon;

  return (
    <div
      className={`border ${config.border} ${config.bg} rounded-lg overflow-hidden transition-all duration-200`}
    >
      <button
        onClick={() => setExpanded(!expanded)}
        className="w-full flex items-center gap-3 p-3 hover:bg-white/5 transition-colors"
      >
        <Icon className={`w-4 h-4 ${config.color} shrink-0`} />
        <Badge
          variant="outline"
          className={`${config.badgeClass} text-xs font-mono shrink-0`}
        >
          {config.label}
        </Badge>
        {step.tool && (
          <Badge
            variant="outline"
            className="bg-slate-700/50 text-slate-300 border-slate-600 text-xs font-mono shrink-0"
          >
            {step.tool}
          </Badge>
        )}
        <span className="text-slate-400 text-xs truncate flex-1 text-left">
          {step.content.substring(0, 80)}...
        </span>
        {expanded ? (
          <ChevronDown className="w-4 h-4 text-slate-500 shrink-0" />
        ) : (
          <ChevronRight className="w-4 h-4 text-slate-500 shrink-0" />
        )}
      </button>
      {expanded && (
        <div className="px-4 pb-4 pt-1">
          {step.args && (
            <div className="mb-3 p-2 bg-slate-900/50 rounded-md border border-slate-700/50">
              <p className="text-xs font-mono text-slate-500 mb-1">
                Tool Arguments:
              </p>
              {Object.entries(step.args).map(([key, val]) => (
                <div key={key} className="flex gap-2 text-xs font-mono">
                  <span className="text-cyan-400">{key}:</span>
                  <span className="text-slate-300">{val}</span>
                </div>
              ))}
            </div>
          )}
          <p className="text-sm text-slate-200 leading-relaxed whitespace-pre-wrap">
            {step.content}
          </p>
        </div>
      )}
    </div>
  );
}

export default function AgentChat() {
  const { setQuery } = useSearchContext();
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [input, setInput] = useState("");
  const [isProcessing, setIsProcessing] = useState(false);
  const [agentType, setAgentType] = useState("default");
  const [availableAgents, setAvailableAgents] = useState<AgentInfo[]>([]);
  const scrollRef = useRef<HTMLDivElement>(null);

  // Load initial data - NO demo data, fetch from backend
  useEffect(() => {
    const savedMessages = localStorage.getItem("agentChatHistory");
    if (savedMessages && savedMessages.length > 2) {
      try {
        setMessages(JSON.parse(savedMessages));
      } catch (e) {
        console.error("Failed to load chat history", e);
      }
    }

    const fetchAgents = async () => {
      try {
        const data = await getAvailableAgents();
        setAvailableAgents(data.agents);
        if (data.agents.length > 0) {
          setAgentType(data.agents[0].id);
        }
      } catch (err) {
        console.error("Failed to load available agents", err);
      }
    };

    fetchAgents();
  }, []);

  // Save messages to localStorage whenever they change
  useEffect(() => {
    if (messages.length > 0) {
      localStorage.setItem("agentChatHistory", JSON.stringify(messages));
    }
  }, [messages]);

  const handleSend = async () => {
    if (!input.trim() || isProcessing) return;

    const userMessage: ChatMessage = {
      id: Date.now().toString(),
      role: "user",
      content: input.trim(),
      timestamp: new Date().toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
      }),
    };

    setMessages((prev) => [...prev, userMessage]);
    setInput("");
    setQuery(userMessage.content);
    setIsProcessing(true);

    try {
      const response: ChatResponse = await sendChatMessage(userMessage.content, agentType);

      // Convert backend response to frontend format
      const agentMessage: ChatMessage = {
        id: (Date.now() + 1).toString(),
        role: "agent",
        content: response.response,
        timestamp: new Date().toLocaleTimeString([], {
          hour: "2-digit",
          minute: "2-digit",
        }),
        steps: [
          // Thought process
          ...response.thought_process.map((thought, index) => ({
            type: "thought" as const,
            content: thought.content,
            timestamp: new Date().toLocaleTimeString(),
          })),
          // Actions
          ...response.actions.map((action, index) => ({
            type: "action" as const,
            content: action.result,
            tool: action.tool,
            args: { input: action.input },
            timestamp: new Date().toLocaleTimeString(),
          })),
          // Observations
          ...response.observations.map((observation, index) => ({
            type: "observation" as const,
            content: typeof observation === 'string' ? observation : observation.content,
            timestamp: new Date().toLocaleTimeString(),
          })),
          // Final answer
          {
            type: "answer" as const,
            content: response.response,
            timestamp: new Date().toLocaleTimeString(),
          },
        ],
      };

      setMessages((prev) => [...prev, agentMessage]);
    } catch (error) {
      console.error("Error sending message:", error);
      const errorMessage: ChatMessage = {
        id: (Date.now() + 1).toString(),
        role: "agent",
        content: "Sorry, I encountered an error while processing your request. Please check if the backend server is running.",
        timestamp: new Date().toLocaleTimeString([], {
          hour: "2-digit",
          minute: "2-digit",
        }),
        error: error instanceof Error ? error.message : "Unknown error",
      };
      setMessages((prev) => [...prev, errorMessage]);
    } finally {
      setIsProcessing(false);
    }
  };

  const suggestedQueries = [
    "Find EGFR inhibitors for non-small cell lung cancer",
    "Analyze BACE1 inhibitors for Alzheimer's treatment",
    "Search for JAK2 inhibitors in myelofibrosis",
    "Identify CDK4/6 inhibitors with low toxicity profiles",
  ];

  return (
    <div className="flex flex-col h-full">
      {/* Header */}
      <div className="flex items-center gap-3 p-4 border-b border-slate-700/50">
        <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-violet-500 flex items-center justify-center">
          <Bot className="w-5 h-5 text-white" />
        </div>
        <div>
          <h2 className="text-sm font-semibold text-slate-100">
            ReAct Research Agent
          </h2>
          <p className="text-xs text-slate-400">
            Drug Discovery • Compound AI • RAG-Enhanced
          </p>
        </div>
        <div className="ml-4">
          <label htmlFor="agent-type" className="text-[11px] uppercase tracking-[0.2em] text-slate-500">
            Agent
          </label>
          <select
            id="agent-type"
            value={agentType}
            onChange={(e) => setAgentType(e.target.value)}
            className="mt-1 w-full rounded-md bg-slate-800 border border-slate-700 text-slate-100 text-xs px-2 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500/50"
          >
            <option value="default">Default Research Agent</option>
            {availableAgents.map((agent) => (
              <option key={agent.id} value={agent.id}>
                {agent.name}
              </option>
            ))}
          </select>
        </div>
        <div className="ml-auto flex items-center gap-2">
          <div className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
          <span className="text-xs text-emerald-400 font-medium">Online</span>
        </div>
      </div>

      {/* Messages */}
      <ScrollArea className="flex-1 p-4" ref={scrollRef}>
        <div className="space-y-6 max-w-4xl mx-auto">
          {messages.map((msg) => (
            <div key={msg.id}>
              {msg.role === "user" ? (
                <div className="flex gap-3 justify-end">
                  <div className="max-w-[80%]">
                    <div className="bg-cyan-600/20 border border-cyan-500/30 rounded-2xl rounded-tr-sm px-4 py-3">
                      <p className="text-sm text-slate-100">{msg.content}</p>
                    </div>
                    <p className="text-xs text-slate-500 mt-1 text-right">
                      {msg.timestamp}
                    </p>
                  </div>
                  <div className="w-8 h-8 rounded-lg bg-slate-700 flex items-center justify-center shrink-0">
                    <User className="w-4 h-4 text-slate-300" />
                  </div>
                </div>
              ) : (
                <div className="flex gap-3">
                  <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-violet-500 flex items-center justify-center shrink-0">
                    <Sparkles className="w-4 h-4 text-white" />
                  </div>
                  <div className="flex-1 space-y-2">
                    {msg.steps?.map((step, idx) => (
                      <ReActStepCard key={idx} step={step} />
                    ))}
                    <p className="text-xs text-slate-500 mt-1">
                      {msg.timestamp}
                    </p>
                  </div>
                </div>
              )}
            </div>
          ))}
          {isProcessing && (
            <div className="flex gap-3">
              <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-violet-500 flex items-center justify-center shrink-0">
                <Sparkles className="w-4 h-4 text-white" />
              </div>
              <div className="flex items-center gap-2 px-4 py-3 bg-slate-800/50 border border-slate-700/50 rounded-2xl rounded-tl-sm">
                <Loader2 className="w-4 h-4 text-cyan-400 animate-spin" />
                <span className="text-sm text-slate-400">
                  Agent is reasoning...
                </span>
              </div>
            </div>
          )}
        </div>
      </ScrollArea>

      {/* Suggested Queries */}
      {messages.length <= 2 && (
        <div className="px-4 pb-2">
          <p className="text-xs text-slate-500 mb-2 font-medium uppercase tracking-wider">
            Suggested Queries
          </p>
          <div className="flex flex-wrap gap-2">
            {suggestedQueries.map((q, i) => (
              <button
                key={i}
                onClick={() => setInput(q)}
                className="text-xs px-3 py-1.5 rounded-full border border-slate-700 text-slate-400 hover:text-cyan-400 hover:border-cyan-500/50 transition-colors"
              >
                {q}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Input */}
      <div className="p-4 border-t border-slate-700/50">
        <div className="flex gap-2 max-w-4xl mx-auto">
          <Input
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && handleSend()}
            placeholder="Ask about drug targets, compounds, clinical trials..."
            className="bg-slate-800/50 border-slate-700 text-slate-100 placeholder:text-slate-500 focus-visible:ring-cyan-500/50"
            disabled={isProcessing}
          />
          <Button
            onClick={handleSend}
            disabled={!input.trim() || isProcessing}
            className="bg-cyan-600 hover:bg-cyan-500 text-white shrink-0"
          >
            {isProcessing ? (
              <Loader2 className="w-4 h-4 animate-spin" />
            ) : (
              <Send className="w-4 h-4" />
            )}
          </Button>
        </div>
      </div>
    </div>
  );
}